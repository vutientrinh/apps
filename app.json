{
  "expo": {
    "name": "Jadeway",
    "slug": "jadeway",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#006967",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundImage": "./assets/brand/adaptive-background.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#f6fbfb",
          "dark": {
            "image": "./assets/brand/splash-icon-dark.png",
            "backgroundColor": "#0c1416"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Jadeway to access your photos.",
          "savePhotosPermission": "Allow Jadeway to save images to your photo library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
